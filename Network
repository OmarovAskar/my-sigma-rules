title: Reconnaissance and Network Tooling Execution
id: f1d72ffe-39dc-4170-9015-46fde097009a
status: experimental
description: Detects execution of network scanning and reconnaissance tools like nmap, nc, and netcat from bash history.
author: Oskar
date: 2026-03-30
tags:
    - attack.reconnaissance
    - attack.t1595
logsource:
    product: linux
    service: bash_history
detection:
    selection:
        # Кавычки помогают движку правильно интерпретировать поле с точкой из твоего лога
        "process.command_line"|contains:
            - 'nmap'
            - 'nmaps'
            - 'netcat'
            - 'ncat'
            - 'nc'
            - 'nc.openbsd'
            - 'telnet'
    condition: selection
falsepositives:
    - Legitimate administrator network troubleshooting
level: medium
